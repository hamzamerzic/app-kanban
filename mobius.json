{
  "id": "kanban",
  "name": "Kanban",
  "version": "0.3.0",
  "description": "Kanban boards that open where you left off: drag-and-drop lists, due dates and assignees, and live collaboration with people on their own Möbius.",
  "author": "hamzamerzic",
  "license": "MIT",
  "homepage": "https://github.com/hamzamerzic/app-kanban",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": []
  },
  "offline": {
    "reads": true,
    "writes": "queued",
    "execution": "full"
  },
  "source_files": [
    "domain.js",
    "storage.js",
    "sync.js",
    "theme.js",
    "ui/Home.jsx",
    "ui/Board.jsx"
  ]
}